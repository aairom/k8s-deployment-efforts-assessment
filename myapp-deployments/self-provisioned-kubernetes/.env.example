# =============================================================================
# .env.example — Self-Provisioned Kubernetes — MyApp secrets template
# =============================================================================
# Copy this file to .env and fill in real values.
# The .env file is listed in .gitignore and must NEVER be committed to Git.
#
# This file is used ONLY with Strategy A (Sealed Secrets / kubeseal):
#   kubectl create secret generic myapp-secret \
#     --from-env-file=.env -n myapp --dry-run=client -o yaml \
#     | kubeseal --format yaml > sealed-secret.yaml
#
# For Strategy B (ESO + HashiCorp Vault), populate Vault directly — see README-secrets.md.
# =============================================================================

# PostgreSQL password — min 20 chars, mixed case + symbols recommended
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Application API key — generate with: openssl rand -hex 32
APP_API_KEY=REPLACE_WITH_32_CHAR_HEX_KEY

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET

# Container registry robot token (Harbor / Quay / other private registry)
# Leave empty if using a public image or a separate imagePullSecret.
REGISTRY_TOKEN=REPLACE_WITH_REGISTRY_ROBOT_TOKEN
